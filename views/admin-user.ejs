<%- include('partials/header') %>

<div class="page-head">
  <h1>User: <%= user.email %></h1>
  <a href="/admin" class="btn btn-secondary">← Back to Admin</a>
</div>

<p class="muted">Role: <strong><%= user.role %></strong> · Joined: <%= user.created_at %></p>

<h2>Categories & Budgets (<%= month %>)</h2>
<% if (categories.length === 0) { %>
  <div class="empty-state"><p>This user has no categories yet.</p></div>
<% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Category</th>
        <th>Monthly Budget</th>
      </tr>
    </thead>
    <tbody>
      <% categories.forEach(cat => { %>
        <tr>
          <td><%= cat.name %></td>
          <td><%= budgetByCategory[cat.id] != null ? Number(budgetByCategory[cat.id]).toFixed(2) : '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2>Expenses</h2>
<% if (expenses.length === 0) { %>
  <div class="empty-state"><p>This user has no expenses yet.</p></div>
<% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Category</th>
        <th>Amount</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <% expenses.forEach(exp => { %>
        <tr>
          <td><%= exp.date %></td>
          <td><%= exp.category_name %></td>
          <td><%= Number(exp.amount).toFixed(2) %></td>
          <td><%= exp.description || '' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>