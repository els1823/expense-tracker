<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Expense Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="<%= currentUser ? (currentUser.role === 'admin' ? '/admin' : '/dashboard') : '/login' %>">
        Expense Tracker
      </a>
     <% if (currentUser) { %>
  <nav class="main-nav">
    <% if (currentUser.role === 'admin') { %>
      <a href="/admin">Admin</a>
    <% } %>
    <a href="/dashboard">Dashboard</a>
    <a href="/expenses">Expenses</a>
    <a href="/categories">Categories</a>

    <div class="user-menu">
      <button type="button" class="user-menu-btn" id="userMenuBtn">
        <% if (currentUser.profilePicture) { %>
          <img src="<%= currentUser.profilePicture %>" alt="Avatar" class="avatar-small">
        <% } else { %>
          <span class="avatar-placeholder"><%= (currentUser.username || currentUser.email || '?').charAt(0).toUpperCase() %></span>
        <% } %>
        <span class="user-name"><%= currentUser.username || currentUser.fullName || currentUser.email %></span>
        <span class="chevron">▾</span>
      </button>
      <div class="user-dropdown" id="userDropdown">
        <a href="/profile">Profile</a>
        <form action="/logout" method="POST">
          <button type="submit">Logout</button>
        </form>
      </div>
    </div>

    <button type="button" class="theme-toggle" id="themeToggle" title="Toggle dark mode">
      🌙 Dark
    </button>
  </nav>
<% } %>
    </div>
  </header>
  <main class="container">
      <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>