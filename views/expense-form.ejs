<%- include('partials/header') %>

<h1><%= title %></h1>

<div class="form-card">
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <form method="POST" action="<%= action %>" enctype="multipart/form-data">
    <label for="categoryId">Category</label>
    <select id="categoryId" name="categoryId" required>
      <option value="">Select a category</option>
      <% categories.forEach(cat => { %>
        <option value="<%= cat.id %>"
          <%= expense && String(expense.category_id) === String(cat.id) ? 'selected' : '' %>>
          <%= cat.name %>
        </option>
      <% }) %>
    </select>

    <label for="amount">Amount</label>
    <input type="number" id="amount" name="amount" step="0.01" min="0.01" required
           value="<%= expense ? expense.amount : '' %>">

    <label for="date">Date</label>
    <input type="date" id="date" name="date" required
           value="<%= expense ? expense.date : new Date().toISOString().slice(0,10) %>">

    <label for="description">Description (optional)</label>
    <input type="text" id="description" name="description" maxlength="500"
           value="<%= expense && expense.description ? expense.description : '' %>">
    
    <label for="receipt">Receipt (optional)</label>
    <input type="file" id="receipt" name="receipt" accept="image/*,.pdf">
    <% if (expense && expense.receipt_image) { %>
      <p class="hint">
        Current receipt: 
        <a href="<%= expense.receipt_image %>" target="_blank">View</a>
      </p>
    <% } %>
    <button type="submit" class="btn btn-primary">Save expense</button>
  </form>
</div>

<%- include('partials/footer') %>